PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173,https://carelink-bay.vercel.app

# Supabase
SUPABASE_URL=https://oejvlgmoxefwwawqdpwo.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# PostgreSQL (Dashboard → Project Settings → Database)
SUPABASE_DB_USE_POOLER=true
SUPABASE_DB_POOLER_HOST=aws-1-ap-southeast-1.pooler.supabase.com
SUPABASE_DB_PASSWORD=your-database-password
# Prefer Transaction pooler on Vercel (port 6543). Direct db.* is IPv6-only.
# DATABASE_URL=postgresql://postgres.oejvlgmoxefwwawqdpwo:YOUR_PASSWORD@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres

JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=8h

UNISMS_SECRET_KEY=
UNISMS_SENDER_ID=Unisoft
SMS_BRAND_NAME=CareLink
APP_PUBLIC_URL=https://carelink-bay.vercel.app
APP_TIMEZONE=Asia/Manila
SMS_INCLUDE_LINKS=true

AI_API_URL=http://localhost:8001

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=CareLink <no-reply@localhost>

# Vercel: paste the same server secrets into the Vercel project env vars.
# Frontend: VITE_API_BASE_URL=/api (same-origin serverless api/index.js)
